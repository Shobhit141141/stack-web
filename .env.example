# CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5500"

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# Supabase
## supabase configuration
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
## storage bucket for files
SUPABASE_STORAGE_BUCKET="files"
## signed download URL lifetime (seconds); server clamps 60–604800
# SIGNED_URL_EXPIRES_SECONDS="3600"

## optional scanned-PDF OCR path (requires implementing tryOcrPdf in src/extraction/ocr.util.ts)
# OCR_ENABLED="true"

# Embeddings (post-upload: chunk → embed → file_chunks, vector 1536)
## Provider: openai (default) | google | gemini (alias for google; Gemini Developer API / AI Studio)
# EMBEDDING_PROVIDER="openai"

# --- OpenAI (default; when EMBEDDING_PROVIDER is openai or unset) ---
# OPENAI_API_KEY="sk-..."
# EMBEDDING_MODEL="text-embedding-3-small"

# --- Google AI Studio / Gemini API (when EMBEDDING_PROVIDER=google or gemini) ---
# EMBEDDING_PROVIDER="google"
# GEMINI_API_KEY="your-gemini-api-key"
## e.g. text-embedding-004, gemini-embedding-001 — shorter native vectors are zero-padded to 1536 for pgvector
# GOOGLE_EMBEDDING_MODEL="text-embedding-004"
