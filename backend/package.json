{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "dev:url-worker": "tsx watch src/workers/url-worker.ts",
    "start": "tsx src/index.ts",
    "start:url-worker": "tsx src/workers/url-worker.ts",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test-pdfs:generate": "node scripts/generate-test-pdfs.mjs",
    "auth:copy-token": "node scripts/copy-access-token.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.99",
    "@prisma/client": "^6.19.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "@supabase/supabase-js": "^2.49.1",
    "bullmq": "^5.73.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.1.0",
    "ioredis": "^5.10.1",
    "linkedom": "^0.18.12",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "openai": "^6.33.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.5",
    "tesseract.js": "^5.1.1",
    "tiktoken": "^1.0.22",
    "unpdf": "^1.6.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.5",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
