# CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5500"

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# Qdrant (chunk embeddings; euclidean /1536 dims)
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY="..." # cloud / authenticated clusters
QDRANT_COLLECTION="file_chunks"

# Supabase
## supabase configuration
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
## storage bucket for files
SUPABASE_STORAGE_BUCKET="files"
## signed download URL lifetime (seconds); server clamps 60–604800
SIGNED_URL_EXPIRES_SECONDS="3600"

## optional scanned pdf ocr (tesseract first; weak/empty → vision LLM if RAG provider configured)
OCR_ENABLED="true"
# OCR_MAX_PAGES="8"
# set to false to disable AI OCR fallback (tesseract only)
# OCR_AI_FALLBACK="true"

## PDF embedded images: extract → vision caption → same vector index as text (set to false to disable)
# PDF_EMBEDDED_IMAGES_ENABLED="false"
## optional absolute path for cached figure webp (default: <cwd>/.cache/pdf-extract)
# PDF_EXTRACT_CACHE_DIR="/var/lib/stack/pdf-extract"

# Embeddings (google or openai)
EMBEDDING_PROVIDER="openai"

## --- OpenAI ---
OPENAI_API_KEY="sk-..."
EMBEDDING_MODEL="text-embedding-3-small"

## --- Google ---
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_EMBEDDING_MODEL="text-embedding-004"

# RAG LLM (google or openai)
RAG_COMPLETION_PROVIDER="openai"
OPENAI_CHAT_MODEL="gpt-4o-mini"
# optional: faster model for Vapi tool calls only (defaults to gpt-4o-mini)
# OPENAI_CHAT_MODEL_VOICE="gpt-4o-mini"

## --- Google ---
GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
# optional: voice webhook only (defaults to gemini-2.5-flash-lite)
# GEMINI_CHAT_MODEL_VOICE="gemini-2.5-flash-lite"
