generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ActivityType {
  upload
  chat
  search
}

enum ContentSummaryStatus {
  pending
  ready
  failed
}

model User {
  id          String   @id @db.Uuid
  email       String   @unique
  userName    String   @unique @map("user_name")
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  files         File[]
  activities    Activity[]
  workspaces    Workspace[]
  conversations Conversation[]

  @@index([userName])
  @@map("users")
}

model Content {
  id             String               @id @default(uuid()) @db.Uuid
  hash           String               @unique
  summary        String?
  summaryStatus  ContentSummaryStatus @default(pending) @map("summary_status")
  summaryUpdatedAt DateTime?          @map("summary_updated_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  files  File[]
  chunks FileChunk[]

  @@map("contents")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files         File[]
  conversations Conversation[]

  @@index([userId])
  @@map("workspaces")
}

model File {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contentId   String   @map("content_id") @db.Uuid
  originalName String  @map("name")
  mimeType    String   @map("type")
  size        BigInt
  storagePath String   @map("storage_path")
  sourceType  String   @default("upload") @map("source_type")
  sourceUrl   String?  @map("source_url")

  workspaceId String? @map("workspace_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastOpenedAt DateTime? @map("last_opened_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentRef Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([contentId])
  @@index([originalName])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, lastOpenedAt(sort: Desc)])
  @@index([workspaceId])
  @@index([userId, workspaceId])
  @@map("files")
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ActivityType
  metadata  Json
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("activities")
}

model Conversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  title       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([workspaceId])
  @@map("conversations")
}

model ChatMessage {
  id             String  @id @default(uuid()) @db.Uuid
  conversationId String  @map("conversation_id") @db.Uuid
  role           String  // "user" | "assistant"
  content        String
  sources        Json?   // AskSource[] for assistant messages
  payload        Json?   // structured message payloads (quiz, quiz result, etc.)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model FileChunk {
  id         String   @id @default(uuid()) @db.Uuid
  contentId  String   @map("content_id") @db.Uuid
  content    String
  chunkIndex Int      @map("chunk_index")
  tokenCount Int      @map("token_count")
  createdAt  DateTime @default(now()) @map("created_at")

  contentRef Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("file_chunks")
}
