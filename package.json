{
  "name": "stack",
  "private": true,
  "description": "Monorepo: backend (API) + frontend (Vite SPA)",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "dev:all": "npm run dev:backend & npm run dev:frontend",
    "build:extension": "npm run build --prefix extensions/stack-browser"
  }
}
